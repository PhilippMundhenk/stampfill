{
  "name": "stampfill",
  "version": "1.0.0",
  "description": "Stamp text onto PDF templates from a web form, then print or download the result",
  "main": "stampfill.js",
  "bin": {
    "stampfill": "stampfill.js"
  },
  "license": "MIT",
  "author": "Philipp Mundhenk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhilippMundhenk/stampfill.git"
  },
  "homepage": "https://github.com/PhilippMundhenk/stampfill#readme",
  "bugs": {
    "url": "https://github.com/PhilippMundhenk/stampfill/issues"
  },
  "keywords": [
    "pdf",
    "forms",
    "print",
    "ipp",
    "cups",
    "pdf-lib",
    "self-hosted"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "stampfill.js"
  ],
  "scripts": {
    "start": "node stampfill.js",
    "lint": "eslint .",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "c8 node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "mock-ipp": "node test/mock-ipp.js",
    "test:unit:fast": "node --test \"test/unit/**/*.test.js\"",
    "screenshots": "node scripts/screenshots.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.4.0"
  }
}
