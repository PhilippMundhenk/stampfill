# Copy to .env next to docker-compose.yml; Docker Compose reads it automatically.

# Image tag to run: a version such as 1.1 or 1.1.0 for predictable updates, or latest for whatever main last built.
STAMPFILL_TAG=1.1

# Admin password for /admin. Leave empty to have a random one generated and printed to the log on first start.
ADMIN_PASSWORD=change-me

# Trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy (1) or not (0). Only set 1 when a proxy you
# control is in front; otherwise clients could spoof their address and bypass the login limiter. The Caddy
# overlay sets it by itself.
TRUST_PROXY=0

# Address the port is published on. 0.0.0.0 for use on a LAN, 127.0.0.1 when a reverse proxy on this host is in front.
BIND=0.0.0.0

# Force the Secure flag on cookies (1) when HTTPS is terminated by a proxy that does not send X-Forwarded-Proto.
SECURE_COOKIES=0

# Upload limit for PDF templates in megabytes.
MAX_PDF_MB=25

# User and group id the container runs as. /data must be writable by them. Keep 1000:1000 with the named
# volume; with a bind mount use the owner of the host folder (find yours with "id -u" and "id -g").
PUID=1000
PGID=1000

# Admin login of the optional CUPS sidecar (docker-compose.cups.yml). Required by the overlay; CUPS is not
# published on the network (see the overlay file for how to reach it).
CUPSADMIN=print
CUPSPASSWORD=change-me-too

# Public hostname, only needed for the Caddy HTTPS overlay (docker-compose.caddy.yml).
DOMAIN=forms.example.com
